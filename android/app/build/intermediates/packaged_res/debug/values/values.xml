<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="basicfit_dark_gray">#2C2C2C</color>
    <color name="basicfit_light_gray">#F5F5F5</color>
    <color name="basicfit_orange">#FF6B35</color>
    <color name="black">#FF000000</color>
    <color name="colorAccent">#5B8DEF</color>
    <color name="colorPrimary">#00C8B5</color>
    <color name="colorPrimaryDark">#009381</color>
    <color name="ic_launcher_background">#00C9A7</color>
    <color name="ic_launcher_bg">#00C8B5</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">MYC</string>
    <string name="custom_url_scheme">io.ionic.starter</string>
    <string name="package_name">io.ionic.starter</string>
    <string name="title_activity_main">MYC</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
    <style name="Theme.BasicFitApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/basicfit_orange</item>
        <item name="colorPrimaryDark">@color/basicfit_dark_gray</item>
        <item name="colorAccent">@color/teal_200</item>

        
        <item name="android:statusBarColor" ns1:targetApi="l">@color/basicfit_orange</item>
        <item name="android:navigationBarColor">@color/white</item>

        
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>
</resources>